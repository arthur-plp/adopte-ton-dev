# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files (ne jamais committer les secrets)
# Règle large (.env.*) pour couvrir aussi les .env.<service> de infra/
# (.env.api-gateway, .env.matching-svc…) qui n'étaient pas couverts par les
# anciens motifs littéraux — seuls les .env.example/.env.production.example
# (templates, sans secrets) restent trackés.
.env
.env.*
!.env.example
!.env.production.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Prisma generated client
**/prisma/generated
**/generated/prisma
**/src/generated

# Agent interne
.agents/

# Fichiers auto-générés divers
skills-lock.json

# Docker volumes locaux
infra/volumes/

# Logs
*.log
