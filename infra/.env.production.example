# ══════════════════════════════════════════════════════════════════════════════
# Adopte Ton Dev — Variables d'environnement PRODUCTION
#
# Sur le VPS, créer les fichiers suivants dans /opt/adopte-ton-dev/infra/ :
#   .env              (variables communes/infra + build args — DOIT être nommé
#                       exactement ".env" : c'est le seul nom que Docker Compose
#                       charge automatiquement pour la substitution ${VAR})
#   .env.web          (Next.js)
#   .env.api-gateway  (NestJS Gateway)
#   .env.auth-service (NestJS Auth Service)
#   .env.jobs-svc     (NestJS Jobs Service)
#   .env.applications-svc (NestJS Applications Service)
#   .env.payment-svc  (NestJS Payment Service)
#   .env.matching-svc (NestJS Matching Service — stateless, pas de DB)
#   .env.messaging-svc (NestJS Messaging Service)
#   .env.notifications-svc (NestJS Notifications Service)
#   .env.email-svc    (NestJS Email Service)
#
# Ne jamais committer ces fichiers. Ils sont dans .gitignore.
# ══════════════════════════════════════════════════════════════════════════════


# ── .env (docker-compose.prod.yml les lit via ${VAR}, y compris les build args) ──
POSTGRES_USER=atd
POSTGRES_PASSWORD=CHANGE_MOI_MOT_DE_PASSE_FORT

RABBITMQ_USER=atd
RABBITMQ_PASSWORD=CHANGE_MOI_MOT_DE_PASSE_FORT

# Dupliqués depuis .env.web ci-dessous : Next.js inline les variables
# NEXT_PUBLIC_* dans le bundle client au moment du `docker compose build`, pas
# au runtime — docker-compose.prod.yml doit donc les lire ICI (substitution
# ${VAR} dans le YAML), pas seulement dans .env.web (qui ne s'applique qu'au
# conteneur déjà démarré).
NEXT_PUBLIC_API_URL=https://VOTRE_SOUS_DOMAINE.VOTRE_DOMAINE.FR/api/v1
NEXT_PUBLIC_BETTER_AUTH_URL=https://VOTRE_SOUS_DOMAINE.VOTRE_DOMAINE.FR


# ── .env.web (Next.js — port 3000) ───────────────────────────────────────────
NODE_ENV=production

# URL publique de l'application (votre sous-domaine)
BETTER_AUTH_URL=https://VOTRE_SOUS_DOMAINE.VOTRE_DOMAINE.FR
NEXT_PUBLIC_BETTER_AUTH_URL=https://VOTRE_SOUS_DOMAINE.VOTRE_DOMAINE.FR

# URL de l'API Gateway (depuis le navigateur)
NEXT_PUBLIC_API_URL=https://VOTRE_SOUS_DOMAINE.VOTRE_DOMAINE.FR/api/v1

# BetterAuth — générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_MOI_SECRET_FORT_32_CHARS

# Base de données (BetterAuth sessions)
DATABASE_URL=postgresql://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@postgres:5432/atd_users

# OAuth GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails (Resend)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=Adopte Ton Dev <noreply@VOTRE_DOMAINE.FR>


# ── .env.api-gateway (NestJS Gateway — port 4000) ────────────────────────────
NODE_ENV=production
PORT=4000

# BetterAuth (même secret que le front)
BETTER_AUTH_SECRET=CHANGE_MOI_SECRET_FORT_32_CHARS
BETTER_AUTH_URL=https://VOTRE_SOUS_DOMAINE.VOTRE_DOMAINE.FR

# Base de données (sessions BetterAuth)
DATABASE_URL=postgresql://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@postgres:5432/atd_users

# Micro-services (réseau Docker interne)
# NB : auth-service est référencé sous deux noms de variable selon le module
# (USERS_SVC_* dans admin/users, AUTH_SVC_* dans job-offers/payment/reports/
# matching) — incohérence historique du code, les deux doivent donc pointer
# vers le même service tant qu'elle n'est pas corrigée au niveau du code.
USERS_SVC_HOST=auth-service
USERS_SVC_PORT=3001
AUTH_SVC_HOST=auth-service
AUTH_SVC_PORT=3001
JOBS_SVC_HOST=jobs-svc
JOBS_SVC_PORT=3002
APPLICATIONS_SVC_HOST=applications-svc
APPLICATIONS_SVC_PORT=3003
PAYMENT_SVC_HOST=payment-svc
PAYMENT_SVC_PORT=3004
MATCHING_SVC_HOST=matching-svc
MATCHING_SVC_PORT=3005
MESSAGING_SVC_HOST=messaging-svc
MESSAGING_SVC_PORT=3006
NOTIFICATIONS_SVC_HOST=notifications-svc
NOTIFICATIONS_SVC_PORT=3007

# Écoute TCP de la Gateway elle-même (app hybride) — réseau Docker interne
GATEWAY_TCP_HOST=0.0.0.0
GATEWAY_TCP_PORT=4001

# Rate-limiting partagé entre instances (fail-open si injoignable : ne bloque
# jamais l'API, désactive juste silencieusement la limite — bien vérifier que
# cette variable est présente pour ne pas perdre la protection sans s'en rendre compte)
REDIS_URL=redis://redis:6379

# CORS (autoriser uniquement le front)
CORS_ORIGIN=https://VOTRE_SOUS_DOMAINE.VOTRE_DOMAINE.FR

# ── .env.auth-service (NestJS Auth — port 3001) ──────────────────────────────
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

DATABASE_URL=postgresql://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@postgres:5432/atd_users
CLOUDAMQP_URL=amqp://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@rabbitmq:5672

# API GitHub (pour l'import des repos — optionnel mais recommandé)
# Créer sur https://github.com/settings/tokens (scope : public_repo)
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ── .env.jobs-svc (NestJS Jobs — port 3002) ──────────────────────────────────
NODE_ENV=production
PORT=3002
HOST=0.0.0.0

DATABASE_URL=postgresql://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@postgres:5432/atd_jobs
CLOUDAMQP_URL=amqp://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@rabbitmq:5672

# Micro-service applications-svc (réseau Docker interne — vérification des candidatures actives avant archivage/suppression)
APPLICATIONS_SVC_HOST=applications-svc
APPLICATIONS_SVC_PORT=3003

# Micro-service payment-svc (réseau Docker interne — vérification du plan Free/Pro avant publication d'une offre)
PAYMENT_SVC_HOST=payment-svc
PAYMENT_SVC_PORT=3004

# ── .env.applications-svc (NestJS Applications — port 3003) ─────────────────
NODE_ENV=production
PORT=3003
HOST=0.0.0.0

DATABASE_URL=postgresql://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@postgres:5432/atd_applications
CLOUDAMQP_URL=amqp://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@rabbitmq:5672

# Micro-service jobs-svc (réseau Docker interne — vérification d'ownership de l'offre)
JOBS_SVC_HOST=jobs-svc
JOBS_SVC_PORT=3002

# Pièces justificatives (S3) — URLs presignées, aucun fichier ne transite par le service
AWS_S3_BUCKET=atd-documents-prod
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── .env.payment-svc (NestJS Payment — port 3004) ────────────────────────────
NODE_ENV=production
PORT=3004
HOST=0.0.0.0

DATABASE_URL=postgresql://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@postgres:5432/atd_payment
CLOUDAMQP_URL=amqp://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@rabbitmq:5672

# Stripe (mode live en production) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# ── .env.matching-svc (NestJS Matching — port 3005, stateless, pas de DB) ────
NODE_ENV=production
PORT=3005
HOST=0.0.0.0

# Micro-service auth-service (réseau Docker interne — recherche de profils développeurs)
AUTH_SVC_HOST=auth-service
AUTH_SVC_PORT=3001

# Micro-service jobs-svc (réseau Docker interne — résolution des technos requises via jobOfferId)
JOBS_SVC_HOST=jobs-svc
JOBS_SVC_PORT=3002

# Cache des résultats de recherche (TTL court, invalidé par les events RabbitMQ)
REDIS_URL=redis://redis:6379

# Consumer RabbitMQ (developer.profile.updated, job.published) → invalidation du cache
CLOUDAMQP_URL=amqp://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@rabbitmq:5672

# ── .env.messaging-svc (NestJS Messaging — port 3006) ────────────────────────
NODE_ENV=production
PORT=3006
HOST=0.0.0.0

DATABASE_URL=postgresql://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@postgres:5432/atd_messaging
CLOUDAMQP_URL=amqp://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@rabbitmq:5672

# ── .env.notifications-svc (NestJS Notifications — port 3007) ────────────────
NODE_ENV=production
PORT=3007
HOST=0.0.0.0

DATABASE_URL=postgresql://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@postgres:5432/atd_notifications
CLOUDAMQP_URL=amqp://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@rabbitmq:5672

# Vérification du statut réel de l'offre + critères avant de matcher les alertes
JOBS_SVC_HOST=jobs-svc
JOBS_SVC_PORT=3002

# Push temps réel (realtime.pushToUser) sur la Gateway après chaque notification
GATEWAY_TCP_HOST=api-gateway
GATEWAY_TCP_PORT=4001

# ── .env.email-svc (NestJS Email — port 3008) ────────────────────────────────
NODE_ENV=production
PORT=3008
HOST=0.0.0.0

DATABASE_URL=postgresql://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@postgres:5432/atd_email
CLOUDAMQP_URL=amqp://atd:CHANGE_MOI_MOT_DE_PASSE_FORT@rabbitmq:5672

# Résolution des destinataires (nom/email) et du contexte (titre d'offre)
AUTH_SVC_HOST=auth-service
AUTH_SVC_PORT=3001
JOBS_SVC_HOST=jobs-svc
JOBS_SVC_PORT=3002

# Base des liens cliquables dans les emails (front Next.js)
WEB_URL=https://VOTRE_SOUS_DOMAINE.VOTRE_DOMAINE.FR

# Resend
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=Adopte Ton Dev <noreply@VOTRE_DOMAINE.FR>
RESEND_FORCE_SEND=true
