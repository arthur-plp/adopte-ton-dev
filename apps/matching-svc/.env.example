PORT=3005
HOST=0.0.0.0

# auth-service — TCP, source des profils developpeurs (developer.search)
AUTH_SVC_HOST=localhost
AUTH_SVC_PORT=3001

# jobs-svc — TCP, resolution des requiredTechnologies/Levels via jobOfferId
JOBS_SVC_HOST=localhost
JOBS_SVC_PORT=3002

# Cache des resultats de recherche (TTL court, invalide par les events RabbitMQ)
REDIS_URL=redis://localhost:6379

# Consumer RabbitMQ (developer.profile.updated, job.published) -> invalidation du cache
CLOUDAMQP_URL=amqp://atd:atd_dev_password@localhost:5672
