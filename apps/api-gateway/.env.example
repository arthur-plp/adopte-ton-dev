# ──────────────────────────────────────────────────────────────────────────────
# apps/api-gateway — Variables d'environnement NestJS Gateway
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Base de données users (BetterAuth sessions)
# ⚠️ Windows + Docker : utiliser 127.0.0.1 et non localhost (résolution IPv6)
DATABASE_URL=postgresql://atd:password@127.0.0.1:5432/atd_users

# BetterAuth (même secret que le front pour vérifier les sessions)
BETTER_AUTH_SECRET=jDhrr29wA3c982qsrRz7euBrYQA2AqsYpUmqe1wKV9U

# URL des micro-services internes (réseau Docker)
USERS_SVC_URL=http://users-svc:3001

# jobs-svc — TCP microservice (NestJS transport TCP)
JOBS_SVC_HOST=localhost
JOBS_SVC_PORT=3002
# applications-svc — TCP microservice (NestJS transport TCP)
APPLICATIONS_SVC_HOST=localhost
APPLICATIONS_SVC_PORT=3003
MATCHING_SVC_URL=http://matching-svc:3004
MESSAGING_SVC_URL=http://messaging-svc:3005
NOTIFICATIONS_SVC_URL=http://notifications-svc:3006
PAYMENT_SVC_URL=http://payment-svc:3007

# CORS
CORS_ORIGIN=http://localhost:3000
