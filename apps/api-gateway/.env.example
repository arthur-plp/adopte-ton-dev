# ──────────────────────────────────────────────────────────────────────────────
# apps/api-gateway — Variables d'environnement NestJS Gateway
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Base de données users (BetterAuth sessions)
# ⚠️ Windows + Docker : utiliser 127.0.0.1 et non localhost (résolution IPv6)
DATABASE_URL=postgresql://atd:password@127.0.0.1:5432/atd_users

# BetterAuth (même secret que le front pour vérifier les sessions)
BETTER_AUTH_SECRET=jDhrr29wA3c982qsrRz7euBrYQA2AqsYpUmqe1wKV9U

# auth-service (users-svc) — TCP microservice (NestJS transport TCP)
USERS_SVC_HOST=localhost
USERS_SVC_PORT=3001
# jobs-svc — TCP microservice (NestJS transport TCP)
JOBS_SVC_HOST=localhost
JOBS_SVC_PORT=3002
# applications-svc — TCP microservice (NestJS transport TCP)
APPLICATIONS_SVC_HOST=localhost
APPLICATIONS_SVC_PORT=3003
# payment-svc — TCP microservice (NestJS transport TCP)
PAYMENT_SVC_HOST=localhost
PAYMENT_SVC_PORT=3004
# matching-svc — TCP microservice (NestJS transport TCP)
MATCHING_SVC_HOST=localhost
MATCHING_SVC_PORT=3005
# messaging-svc — TCP microservice (NestJS transport TCP)
MESSAGING_SVC_HOST=localhost
MESSAGING_SVC_PORT=3006
# notifications-svc — TCP microservice (NestJS transport TCP)
NOTIFICATIONS_SVC_HOST=localhost
NOTIFICATIONS_SVC_PORT=3007

# Redis (rate-limiting partagé entre instances de la gateway)
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000
