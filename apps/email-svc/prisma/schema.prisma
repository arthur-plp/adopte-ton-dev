generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Idempotence des consumers RabbitMQ (CLAUDE.md §28.2) : déduplique par
// messageId (posé par l'outbox émetteur, cf. OutboxRelayService).
model ProcessedEvent {
  id          String   @id @default(cuid())
  messageId   String   @unique
  processedAt DateTime @default(now())
}
