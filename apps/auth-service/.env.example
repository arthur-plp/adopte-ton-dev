# ──────────────────────────────────────────────────────────────────────────────
# apps/auth-service — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# Base de données utilisateurs
DATABASE_URL=postgresql://user:password@localhost:5432/atd_users

# BetterAuth
BETTER_AUTH_SECRET=your-better-auth-secret-here
BETTER_AUTH_URL=http://localhost:3000

# OAuth Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# RabbitMQ
CLOUDAMQP_URL=amqp://atd:password@localhost:5672
