NODE_ENV=development
PORT=3001

# Base de données utilisateurs
DATABASE_URL=postgresql://atd:atd_dev_password@localhost:5432/atd_users

# BetterAuth
BETTER_AUTH_SECRET=change_me_in_production_min_32_chars
BETTER_AUTH_URL=http://localhost:3000

# OAuth GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# RabbitMQ
CLOUDAMQP_URL=amqp://atd:atd_dev_password@localhost:5672
