DATABASE_URL=postgresql://atd:atd_dev_password@localhost:5432/atd_applications
CLOUDAMQP_URL=amqp://atd:atd_dev_password@localhost:5672
PORT=3003

# jobs-svc — TCP microservice, utilisé pour vérifier l'ownership/statut de l'offre
JOBS_SVC_HOST=localhost
JOBS_SVC_PORT=3002

# Stockage des pièces justificatives (S3) — URLs presignées, aucun fichier ne transite par le service
AWS_S3_BUCKET=atd-documents-dev
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
