DATABASE_URL=postgresql://atd:atd_dev_password@localhost:5432/atd_notifications
CLOUDAMQP_URL=amqp://atd:atd_dev_password@localhost:5672
PORT=3007

# jobs-svc — TCP, utilisé pour vérifier le statut réel de l'offre et ses
# critères (technos/remote/localisation) avant de matcher les alertes
JOBS_SVC_HOST=localhost
JOBS_SVC_PORT=3002

# Gateway — TCP, utilisé pour pousser une notification en temps réel à
# l'utilisateur connecté (cf. RealtimeGateway côté api-gateway)
GATEWAY_TCP_HOST=localhost
GATEWAY_TCP_PORT=4001
